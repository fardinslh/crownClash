# Local Docker Compose development only. Copy to .env; never commit secrets.
ALLOW_GUEST_AUTH=true
NAKAMA_SERVER_KEY=defaultkey
NAKAMA_CONSOLE_USER=admin
NAKAMA_CONSOLE_PASSWORD=replace-with-a-local-password

# Optional. Required only when testing the corresponding real Mini App auth flow.
BALE_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
