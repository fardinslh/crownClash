# Local Docker Compose development only. Copy to .env; never commit secrets.
ALLOW_GUEST_AUTH=true
NAKAMA_SERVER_KEY=defaultkey
NAKAMA_CONSOLE_USER=admin
NAKAMA_CONSOLE_PASSWORD=replace-with-a-local-password

# Optional. Required only when testing the corresponding real Mini App auth flow.
BALE_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# Commercial realm pilot; production launch is Bale-only. Browser guest mode is local QA.
ENABLE_REALM_PILOT=false
ENABLE_COIN_PAYMENTS=false
BALE_BOT_USERNAME=
BALE_WALLET_TOKEN=
# Cryptographically random 32+ URL-safe characters; server-only, never VITE_*.
BALE_PAYMENT_WEBHOOK_SECRET=

# Optional separate operator-only refund credential. Never give this to clients.
COIN_REFUND_OPERATOR_SECRET=

# New async tickets only; existing tickets and live matches keep their pinned rules.
ASYNC_GAMEPLAY_RULES_VERSION=3
