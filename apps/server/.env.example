NODE_ENV=development
PORT=8787
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3002,http://127.0.0.1:3002

# Local dev Postgres started via `npm run db:up` (docker-compose.yml at repo root).
DATABASE_URL=postgresql://crownclash:crownclash@127.0.0.1:5433/crownclash

# Required in production; any value is fine for local dev.
JWT_SECRET=dev-insecure-secret-change-me

# Allows the unauthenticated browser/dev guest login. Must be false in production.
ALLOW_GUEST_AUTH=true

# Bot tokens used to verify Telegram/Bale initData (HMAC-SHA256). Leave blank
# to disable that platform's login (returns 503 platform_not_configured).
TELEGRAM_BOT_TOKEN=
BALE_BOT_TOKEN=

# Reject initData older than this many seconds.
INIT_DATA_MAX_AGE_SECONDS=86400
