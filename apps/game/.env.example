# Backend URL used by the browser client.
VITE_API_URL=http://127.0.0.1:8787

# Nakama. Leave host blank to use the page hostname; this also works when
# testing from a phone on the same LAN.
VITE_NAKAMA_HOST=
VITE_NAKAMA_PORT=7350
VITE_NAKAMA_SSL=false
VITE_NAKAMA_SERVER_KEY=defaultkey

# Development-only escape hatch. Keep false or unset in production builds.
VITE_ALLOW_LOCAL_FALLBACK=true
